{
  "name": "chorepop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute chorepop-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute chorepop-db --remote --file=./schema.sql",
    "keys": "node scripts/generate-secrets.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=20" }
}
